# Copy this file to .env (pnpm setup does it for you).
# SQLite file lives next to this file. Delete it + re-run `pnpm seed` to start fresh.
DATABASE_URI=file:./payload.db
# Any long random string. Never commit the real .env.
PAYLOAD_SECRET=change-me-to-a-long-random-string
# Where the admin panel + REST API are served.
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3300
# Astro dev server, allowed through CORS/CSRF.
FRONTEND_URL=http://localhost:4321
