---
/** Ported from wordpress-reference/theme/single-project.php */
import { convertLexicalToHTML } from '@payloadcms/richtext-lexical/html'
import Base from '@/layouts/Base.astro'
import Blocks from '@/components/blocks/Blocks.astro'
import { getDocBySlug, mediaUrl } from '@/lib/payload'

const { slug } = Astro.params
const project = slug ? await getDocBySlug('projects', slug) : null

if (!project) {
  return new Response(null, { status: 404, statusText: 'Not found' })
}

const completed = new Date(project.completedOn).toLocaleDateString('en-GB', { month: 'long', year: 'numeric' })
// Card A: relationship items are `number | Service` depending on depth. Only render populated ones.
const services = (project.services ?? []).filter((s) => typeof s === 'object')
// Card B
const hero = typeof project.heroImage === 'object' ? project.heroImage : null
const heroSrc = mediaUrl(hero?.sizes?.hero?.url ?? hero?.url)
// Card C: Lexical JSON -> HTML at render time. WordPress analogy: the_content() applying filters.
const bodyHtml = project.body ? convertLexicalToHTML({ data: project.body }) : ''
// Card D: SEO overrides with fallbacks. WordPress analogy: Yoast's title template.
const metaTitle = project.seo?.title || project.title
const metaDescription = project.seo?.description || project.summary
---

<Base title={metaTitle} description={metaDescription}>
  <Fragment slot="head">
    <meta property="og:title" content={metaTitle} />
    <meta property="og:description" content={metaDescription} />
    {heroSrc && <meta property="og:image" content={heroSrc} />}
  </Fragment>

  <a class="back" href="/projects">← All projects</a>

  {heroSrc && <img class="hero" src={heroSrc} alt={hero?.alt ?? ''} />}

  <h1>{project.title}</h1>
  <div class="meta">
    <span class="pill">{project.client}</span>
    <span>{project.role}</span>
    <span>{completed}</span>
    {project.featured && <span class="pill ghost">Featured</span>}
    {
      project.projectUrl && (
        <a href={project.projectUrl} target="_blank" rel="noopener">
          Visit site ↗
        </a>
      )
    }
    {
      project.repoUrl && (
        <a href={project.repoUrl} target="_blank" rel="noopener">
          Code ↗
        </a>
      )
    }
  </div>

  <p class="lede">{project.summary}</p>

  {
    project.stack?.length ? (
      <div class="meta">
        {project.stack.map((item) => (
          <span class="pill ghost">{item.name}</span>
        ))}
      </div>
    ) : null
  }

  {
    project.highlights?.length ? (
      <div class="stats">
        {project.highlights.map((h) => (
          <div class="stat">
            <strong>{h.value}</strong>
            <span>{h.label}</span>
          </div>
        ))}
      </div>
    ) : null
  }

  {bodyHtml && <div class="prose" set:html={bodyHtml} />}

  <Blocks blocks={project.layout} />

  {
    services.length > 0 && (
      <>
        <h2>Services</h2>
        <div class="meta">
          {services.map((s) => (
            <a class="pill ghost" href={`/services/${s.slug}`}>
              {s.title}
            </a>
          ))}
        </div>
      </>
    )
  }
</Base>
