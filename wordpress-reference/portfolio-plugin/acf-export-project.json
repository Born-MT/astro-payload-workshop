[
  {
    "key": "group_project",
    "title": "Project details",
    "location": [[{ "param": "post_type", "operator": "==", "value": "project" }]],
    "fields": [
      {
        "key": "field_client",
        "label": "Client",
        "name": "client",
        "type": "text",
        "required": 1,
        "instructions": "Who it was for. Use \"Personal\" for a side project."
      },
      {
        "key": "field_role",
        "label": "Your role",
        "name": "role",
        "type": "text",
        "required": 1,
        "placeholder": "Lead developer",
        "instructions": "What you did on it, in three words."
      },
      {
        "key": "field_summary",
        "label": "Summary",
        "name": "summary",
        "type": "textarea",
        "required": 1,
        "maxlength": 240,
        "rows": 3,
        "instructions": "One or two sentences for the listing card."
      },
      {
        "key": "field_project_url",
        "label": "Live URL",
        "name": "project_url",
        "type": "url",
        "required": 0
      },
      {
        "key": "field_repo_url",
        "label": "Repository URL",
        "name": "repo_url",
        "type": "url",
        "required": 0
      },
      {
        "key": "field_completed",
        "label": "Completed on",
        "name": "completed_on",
        "type": "date_picker",
        "required": 1,
        "return_format": "Y-m-d"
      },
      {
        "key": "field_stack",
        "label": "Tech stack",
        "name": "stack",
        "type": "repeater",
        "min": 1,
        "max": 8,
        "layout": "table",
        "button_label": "Add technology",
        "sub_fields": [
          { "key": "field_stack_name", "label": "Name", "name": "name", "type": "text", "required": 1, "placeholder": "Astro" }
        ]
      },
      {
        "key": "field_highlights",
        "label": "Highlights",
        "name": "highlights",
        "type": "repeater",
        "min": 1,
        "max": 4,
        "layout": "table",
        "button_label": "Add highlight",
        "sub_fields": [
          { "key": "field_highlight_value", "label": "Value", "name": "value", "type": "text", "required": 1, "placeholder": "0.9s" },
          { "key": "field_highlight_label", "label": "Label", "name": "label", "type": "text", "required": 1, "placeholder": "Largest Contentful Paint" }
        ]
      },
      {
        "key": "field_services",
        "label": "Services used",
        "name": "services",
        "type": "relationship",
        "post_type": ["service"],
        "multiple": 1,
        "return_format": "object",
        "instructions": "STRETCH CARD A: relationship to the Services post type."
      },
      {
        "key": "field_hero",
        "label": "Hero image",
        "name": "hero_image",
        "type": "image",
        "return_format": "array",
        "preview_size": "medium",
        "instructions": "STRETCH CARD B: image upload."
      },
      {
        "key": "field_body",
        "label": "Story",
        "name": "body",
        "type": "wysiwyg",
        "instructions": "STRETCH CARD C: rich text. Problem / what you built / what you learned."
      },
      {
        "key": "field_seo",
        "label": "SEO",
        "name": "seo",
        "type": "group",
        "instructions": "STRETCH CARD D: meta title + description.",
        "sub_fields": [
          { "key": "field_seo_title", "label": "Meta title", "name": "title", "type": "text", "maxlength": 60 },
          { "key": "field_seo_desc", "label": "Meta description", "name": "description", "type": "textarea", "maxlength": 160, "rows": 2 }
        ]
      }
    ]
  }
]
